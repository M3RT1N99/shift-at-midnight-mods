{
  "version": 2,
  "enabled": true,
  "singlePlayerOnly": false,

  "spawn": {
    "enabled": true,
    "maximumActive": 1,
    "chancePerEligibleEncounter": 1.0,
    "minimumSpawnDistanceMeters": 10.0,
    "maximumSpawnDistanceMeters": 30.0,
    "maximumLifetimeSeconds": 35.0
  },

  "attack": {
    "runSpeedMetersPerSecond": 6.0,
    "detonationDistanceMeters": 1.75,
    "fuseSeconds": 0.35
  },

  "effects": {
    "screamEnabled": true,
    "screamVolume": 0.8,
    "explosionRadiusMeters": 4.0,
    "explosionDamage": 100.0,
    "visualScale": 1.0
  },

  "safety": {
    "disableInMultiplayer": false,
    "allowNetworkSends": true
  },

  "logging": {
    "level": "info"
  },

  "multiplayer": {
    "handshakeTimeoutSeconds": 8.0,
    "heartbeatIntervalSeconds": 4.0,
    "peerTimeoutSeconds": 15.0,
    "hostMarkerRepublishSeconds": 5.0
  }
}
