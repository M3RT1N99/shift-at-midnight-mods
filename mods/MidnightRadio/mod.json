{
  "schema": 1,
  "id": "io.github.m3rt1n99.midnightradio",
  "slug": "MidnightRadio",
  "name": "Midnight Radio",
  "version": "1.0.0",
  "releaseDate": "2026-08-13",
  "author": {
    "name": "Marti",
    "contact": "https://github.com/M3RT1N99"
  },
  "license": "MIT",
  "homepage": null,
  "tags": ["audio", "radio", "boombox", "quality-of-life"],
  "description": {
    "en": "Replaces the placeable boombox's built-in loop locally with your own music. Play indexed local files from the F4 panel or, after explicit opt-in, fetch a URL with your own yt-dlp and ffmpeg installations. Multiplayer synchronisation is not enabled in this development build.",
    "de": "Ersetzt die eingebaute Endlosschleife des platzierbaren Boomboxen-Radios lokal durch eigene Musik. Spiele indexierte lokale Dateien über das F4-Fenster oder lade nach ausdrücklicher Zustimmung einen Link mit deinen eigenen yt-dlp- und ffmpeg-Installationen. Multiplayer-Synchronisation ist in diesem Entwicklungsstand nicht aktiviert."
  },

  "game": {
    "id": "shift-at-midnight",
    "name": "Shift At Midnight",
    "publisher": "Kwalee",
    "store": "steam",
    "steamAppId": 3722330,
    "executable": "ShiftAtMidnight.exe",
    "dataDir": "ShiftAtMidnight_Data",
    "compat": {
      "unityVersion": "6000.0.69f1",
      "scriptingBackend": "il2cpp",
      "architecture": "x64",
      "buildGuids": ["8e59f2b32a5f4d15901aa64b66c56dcf"],
      "verifiedBuildIds": [24450017],
      "onBuildGuidMismatch": "warn",
      "onUnityVersionMismatch": "warn"
    }
  },

  "loader": {
    "id": "melonloader",
    "minVersion": "0.7.3",
    "maxVersion": null,
    "runtime": "net6",
    "onMissing": "block",
    "notes": "Requires MelonLoader x64. Interop assemblies are generated by the loader on first launch."
  },

  "dependencies": [],

  "bundledLibraries": [],

  "externalTools": [
    {
      "id": "yt-dlp",
      "required": false,
      "featureGate": "urlDownloads",
      "purpose": "Optional: resolve and fetch audio from a URL the user pastes for local playback. No audio is sent to other players.",
      "bundled": false,
      "autoDownload": false,
      "detect": {
        "executable": "yt-dlp.exe",
        "searchOrder": [
          "{UserData}/MidnightRadio/Tools",
          "PATH",
          "%LOCALAPPDATA%/Microsoft/WinGet/Links",
          "%USERPROFILE%/scoop/shims",
          "C:/ProgramData/chocolatey/bin"
        ],
        "validateWith": ["--ignore-config", "--version"]
      },
      "userNotice": "oneTime"
    },
    {
      "id": "ffmpeg",
      "required": false,
      "featureGate": "urlDownloads",
      "purpose": "Optional: used by yt-dlp to extract and convert URL audio into a format MidnightRadio can decode.",
      "bundled": false,
      "autoDownload": false,
      "detect": {
        "executable": "ffmpeg.exe",
        "searchOrder": [
          "{UserData}/MidnightRadio/Tools",
          "PATH",
          "%LOCALAPPDATA%/Microsoft/WinGet/Links"
        ],
        "resolveSymlinks": true,
        "validateWith": ["-hide_banner", "-version"]
      },
      "userNotice": "oneTime"
    }
  ],

  "payload": [
    {
      "id": "core",
      "src": "payload/Mods/MidnightRadio",
      "dest": "{Mods}/MidnightRadio",
      "kind": "directory",
      "required": true,
      "onConflict": "replace",
      "removeOnUninstall": true
    },
    {
      "id": "userdata-seed",
      "src": "payload/UserData/MidnightRadio",
      "dest": "{UserData}/MidnightRadio",
      "kind": "directory",
      "required": true,
      "onConflict": "skip-existing",
      "removeOnUninstall": false
    }
  ],

  "userData": {
    "root": "{UserData}/MidnightRadio",
    "createDirs": [
      "Music",
      "Cache",
      "Cache/_tmp",
      "Cache/_ytdlp",
      "Tools",
      "Logs"
    ],
    "configFile": "config.json",
    "indexFile": "library.json",
    "preserveOnUninstall": true,
    "purgeableOnRequest": ["Cache", "Logs"],
    "neverPurge": ["Music", "Tools", "config.json"]
  },

  "capabilities": {
    "localOnly": true,
    "coopSafe": true,
    "modifiesGameFiles": false,
    "modifiesGameAssets": false,
    "replacesGameAssets": false,
    "containsGameAssets": false,
    "containsMedia": false,
    "writesOutsideGameDir": false,
    "networkAccess": "optional-user-initiated",
    "spawnsProcesses": "optional-user-initiated",
    "requiresExternalTools": false,
    "optionalExternalTools": true,
    "sendsNetworkRpcs": false,
    "requiresRestart": true,
    "hotReloadable": false,

    "multiplayer": {
      "impact": "presentational-only",
      "allPlayersNeedMod": false,
      "unmoddedPlayersAffected": false,
      "synchronisedPlayback": false,
      "authority": "local-only",
      "notes": "This development build changes playback only for the local player. Its Fusion receive hook and multiplayer session layer are not enabled, and it sends no mod network messages.",
      "contentSharing": {
        "default": "none",
        "notes": "No track identifiers or audio data are transmitted in this development build.",
        "peerToPeerTransfer": {
          "enabled": false,
          "requiresExplicitConsent": true,
          "notes": "Not implemented in this development build; the reserved option remains disabled."
        }
      }
    }
  },

  "conflicts": [],

  "integrity": {
    "algorithm": "sha256",
    "index": "SHA256SUMS"
  }
}
